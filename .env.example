# Handballteck — Konfiguration. Jede Variable hier wird vom Code gelesen;
# was fehlt, nimmt den genannten Standard.

# --- Erreichbarkeit ---------------------------------------------------------
# Die Adresse, unter der dieser Dienst von außen erreichbar ist (Telegram ruft
# den Webhook dort auf, Browser holen die Microsite von dort). Ohne https
# registriert Telegram keinen Webhook.
PUBLIC_URL=https://handball.example.de
PORT=3000
# Welchen Reverse-Proxys der Dienst X-Forwarded-For glaubt: IP-Adressen oder
# CIDR-Bereiche, durch Komma. Leer: keinem — dann teilen sich alle Aufrufer
# einen Rate-Limit-Eimer (lästig, kein Loch). Nie „alle": dann könnte jeder
# Aufrufer seine Adresse fälschen und jedes Rate-Limit umgehen. Eine Zahl von
# Sprüngen nimmt Fastify seit 5.12 nicht mehr an.
# TRUST_PROXY=192.168.0.97
# Ablage der SQLite-Datenbank (im Container /data, als Volume).
DATA_DIR=./data
# Ausdrücklicher Pfad der Datenbankdatei; Standard ist $DATA_DIR/handballteck.db.
# DATABASE_PATH=
# wal (Standard) oder delete — delete nur auf Netzwerk-Dateisystemen.
# SQLITE_JOURNAL_MODE=wal
# LOG_LEVEL=info

# --- Mannschaften -----------------------------------------------------------
# Die Team-IDs aus der Adresse der Mannschaftsseite auf handball.net
# (/team/96254), mehrere durch Komma. Hinter einem Gleichheitszeichen darf ein
# Name stehen, den Dropdown und Bot statt der Altersklasse zeigen:
# TEAM_IDS=96254=B-Jugend,96300=C-Jugend
TEAM_IDS=96254
# Die Vereinsfarben aller Bilder und der Microsite, je #rrggbb; leer bleiben
# es die der HSG Wölfe Voreifel.
# PRIMARY_COLOR=#003e51
# SECONDARY_COLOR=#015069
# ACCENT_COLOR=#0bdbd6
# Wie oft nachgesehen wird (Millisekunden, Standard 15 Minuten, Minimum 5).
# Geholt wird einmal je Kalendertag und am Spieltag ab Anwurf plus 45 Minuten.
# SYNC_INTERVAL_MS=900000

# --- Telegram-Bot (optional) ------------------------------------------------
# Token aus dem BotFather. Ohne Token gibt es keinen Bot, die Microsite läuft trotzdem.
TELEGRAM_BOT_TOKEN=
# Einladungscode: gesetzt, abonniert nur, wer /start <code> schickt oder den
# Link t.me/<bot>?start=<code> öffnet. Leer heißt offen für jeden, der den
# Bot-Namen kennt.
TELEGRAM_INVITE_CODE=
# Chat-IDs des Betreibers, durch Komma: /status, /rundruf, /erledigt, das
# weitergereichte /feedback und die Ausfallmeldungen des Abrufs gehen dorthin.
# /status in irgendeinem Chat nennt die eigene Chat-ID.
TELEGRAM_ADMIN_CHAT_IDS=
# Profiltext und „Was kann dieser Bot?" aus Tabellenplatz und nächstem Spiel
# setzen (überschreibt, was im BotFather steht). false: der Text bleibt von Hand.
# BOT_AUTO_DESCRIPTION=true

# --- Microsite ---------------------------------------------------------------
# Die öffentliche Mannschaftsseite unter PUBLIC_URL/<Team-ID>/ (Standard an).
# SITE_ENABLED=true
# Spielernamen (Torjäger, Kader, Saisonkarte, Spielbericht) auf der Seite
# zeigen — Jugendspieler nur auf Wunsch. Standard aus.
# SITE_PLAYERS=false
# Liefert ein Proxy die Seiten unter einer eigenen Domain aus, steht hier
# deren Wurzel; webcal-Link, Feed und Open-Graph-Vorschau zeigen dann dorthin.
# Die Mannschaftsseite liegt darunter als /<Team-ID>/.
# SITE_URL=https://woelfe.example.de
# Wer die Seite betreibt und wohin Rückmeldungen gehen — steht im Footer.
SITE_OPERATOR=
SITE_FEEDBACK_MAIL=
# Web-Push: das VAPID-Schlüsselpaar wird beim ersten Bedarf erzeugt und in
# der Datenbank abgelegt. Gesetzte Werte gewinnen (bei einem Umzug aus
# Todoteck übernimmt `npm run import:todoteck` das Paar, damit bestehende
# Browser-Anmeldungen gültig bleiben).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.de

# --- Übernahme aus Todoteck (einmalig) ---------------------------------------
# Pfad (im Container) zu einer Todoteck-Datenbank — am besten ein Backup-
# Snapshot. Beim Start werden Telegram-Abonnenten, Browser-Anmeldungen,
# Merker, Verlauf und das VAPID-Schlüsselpaar übernommen, genau einmal; danach
# steht im Log „übersprungen", und die Variable kann wieder raus.
# IMPORT_TODOTECK_DB=/import/familytodo.db

# --- API für das Todoteck-Cockpit --------------------------------------------
# Todoteck liest Übersicht, Details und Bilder über /api/* mit diesem Token
# (Header `Authorization: Bearer …`). Leer heißt: /api/* antwortet 401.
# Erzeugen z. B. mit: openssl rand -hex 32
API_TOKEN=
