# Handballteck — Konfiguration. Jede Variable hier wird vom Code gelesen;
# was fehlt, nimmt den genannten Standard.
#
# Was auf der Einstellungsseite /settings geändert wird (Mannschaften, Farben,
# Abruf-Takt, Telegram-Schalter, Microsite-Texte und -Schalter), geht diesen
# Werten vor. Zurück auf den Wert aus dieser Datei geht es dort per
# „Auf die Umgebung zurücksetzen“. Nur Umgebung bleiben: PUBLIC_URL, PORT,
# TRUST_PROXY, DATA_DIR, DATABASE_PATH, SQLITE_JOURNAL_MODE, LOG_LEVEL,
# IMPORT_TODOTECK_DB, TELEGRAM_BOT_TOKEN, API_TOKEN, VAPID_*, ADMIN_*.

# --- Erreichbarkeit ---------------------------------------------------------
# Die Adresse, unter der dieser Dienst von außen erreichbar ist (Telegram ruft
# den Webhook dort auf, Browser holen die Microsite von dort). Ohne https
# registriert Telegram keinen Webhook.
PUBLIC_URL=https://handball.example.de
PORT=3000
# Welchen Reverse-Proxys der Dienst X-Forwarded-For glaubt: IP-Adressen oder
# CIDR-Bereiche, durch Komma. Leer: keinem — dann teilen sich alle Aufrufer
# einen Rate-Limit-Eimer (lästig, kein Loch). Nie „alle": dann könnte jeder
# Aufrufer seine Adresse fälschen und jedes Rate-Limit umgehen. Eine Zahl von
# Sprüngen nimmt Fastify seit 5.12 nicht mehr an.
# TRUST_PROXY=10.0.0.5
# Ablage der SQLite-Datenbank (im Container /data, als Volume).
DATA_DIR=./data
# Ausdrücklicher Pfad der Datenbankdatei; Standard ist $DATA_DIR/handballteck.db.
# DATABASE_PATH=
# wal (Standard) oder delete — delete nur auf Netzwerk-Dateisystemen.
# SQLITE_JOURNAL_MODE=wal
# LOG_LEVEL=info

# --- Mannschaften -----------------------------------------------------------
# Die Team-IDs aus der Adresse der Mannschaftsseite auf handball.net
# (/team/96254), mehrere durch Komma; die Reihenfolge ist die der Mannschaftswahl.
# Seite und Bot benennen die Mannschaften selbst aus Liga und Namen
# („1. Herren", „3. Herren", „mB-Jugend", „wC-Jugend"). Wer es anders will,
# setzt den Namen hinter ein Gleichheitszeichen:
# TEAM_IDS=96254=B-Jugend,96300=C-Jugend
TEAM_IDS=96254
# Die Mannschaftswahl der Seite hat zwei Ebenen: oben Herren · Frauen · Jungen ·
# Mädchen, darunter die Mannschaften des Bereichs. Der Bereich folgt dem
# Wettbewerb der Quelle; sagt der nichts über das Geschlecht, hilft der Name
# hinter dem Gleichheitszeichen („mB-Jugend", „wC-Jugend", „2. Damen").
# Bereich je Mannschaft, wenn der automatisch gelesene nicht passt:
# herren, frauen, jungen, maedchen, kinder. Auf der Einstellungsseite je
# Mannschaftszeile. Leer: aus Wettbewerb und Name gelesen.
# TEAM_GROUPS=96254=jungen,75796=herren
# Mannschaften des Vereins, die nicht in TEAM_IDS stehen (z. B. als Gegner),
# bei handball.net aber noch unter dem Namen ihres Stammvereins
# laufen, in der Spielvereinigung aber zum Verein gehören: ihre Team-IDs hier,
# dann erscheinen sie überall (Seite, Bilder, Bot, API) als CLUB_NAME. Eine
# römische Ziffer am Ende des Quellnamens („… II") bleibt erhalten.
# CLUB_TEAM_IDS=
# Der Vereinsname — gilt überall für die eigenen Mannschaften (TEAM_IDS) und
# für CLUB_TEAM_IDS, egal wie handball.net sie schreibt.
# CLUB_NAME=HSG Wölfe Voreifel
# Die Vereinsfarben aller Bilder und der Microsite, je #rrggbb; leer bleiben
# es die der HSG Wölfe Voreifel.
# PRIMARY_COLOR=#003e51
# SECONDARY_COLOR=#015069
# ACCENT_COLOR=#0bdbd6
# Wie oft nachgesehen wird (Millisekunden, Standard 15 Minuten, Minimum 5).
# Geholt wird einmal je Kalendertag und am Spieltag ab Anwurf plus 45 Minuten.
# SYNC_INTERVAL_MS=900000
# Live-Takt: Läuft ein Spiel, fragt der Dienst in diesem Abstand nach (ab fünf
# Minuten vor Anwurf; mindestens 20000, Standard eine Minute). Er speichert
# Spielstand, Spieluhr und die letzten Tore für die Live-Ansicht der Seite, die
# sich alle 30 Sekunden selbst lädt; frischer als dieser Takt wird sie nicht.
# 0: aus — dann gibt es keine Live-Ansicht, und am Spieltag wird erst ab Anwurf
# plus 45 Minuten nachgefragt.
# SYNC_LIVE_INTERVAL_MS=60000

# --- Telegram-Bot (optional) ------------------------------------------------
# Token aus dem BotFather. Ohne Token gibt es keinen Bot, die Microsite läuft trotzdem.
TELEGRAM_BOT_TOKEN=
# Einladungscode: gesetzt, abonniert nur, wer /start <code> schickt oder den
# Link t.me/<bot>?start=<code> öffnet. Leer heißt offen für jeden, der den
# Bot-Namen kennt.
TELEGRAM_INVITE_CODE=
# Chat-IDs des Betreibers, durch Komma: /status, /rundruf, /erledigt, das
# weitergereichte /feedback und die Ausfallmeldungen des Abrufs gehen dorthin.
# /status in irgendeinem Chat nennt die eigene Chat-ID.
TELEGRAM_ADMIN_CHAT_IDS=
# Profiltext und „Was kann dieser Bot?" aus Tabellenplatz und nächstem Spiel
# setzen (überschreibt, was im BotFather steht). false: der Text bleibt von Hand.
# BOT_AUTO_DESCRIPTION=true

# --- Microsite ---------------------------------------------------------------
# Die öffentliche Mannschaftsseite unter PUBLIC_URL/<Team-ID>/ (Standard an).
# SITE_ENABLED=true
# Obergrenze für Browser-Anmeldungen (Web-Push) insgesamt. Darüber antwortet
# die Anmeldung mit 503, bis Platz ist — Schutz vor einer vollgelaufenen Tabelle.
# SITE_PUSH_MAX=2000
# Liefert ein Proxy die Seiten unter einer eigenen Domain aus, steht hier
# deren Wurzel; webcal-Link, Feed und Open-Graph-Vorschau zeigen dann dorthin.
# Die Mannschaftsseite liegt darunter als /<Team-ID>/.
# SITE_URL=https://woelfe.example.de
# Darf die Vereinsseite die Microsite in einen Rahmen (iframe) einbetten? Hier
# ihre https-Herkünfte, durch Komma; leer: niemand. Mit ?kompakt=1 lässt die
# eingebettete Seite Logo und Vereinsnamen weg — den zeigt die Vereinsseite schon.
# SITE_FRAME_ANCESTORS=https://woelfevoreifel.clubdesk.com
# Vorschau: Mit PUBLIC_URL/<Team-ID>/?vorab=<Schlüssel> zeigt die Seite,
# was noch nicht öffentlich ist (die Fotos der Vereinsseite). Mindestens 32
# Zeichen (openssl rand -hex 24), sonst bleibt die Vorschau aus. Leer: aus.
# SITE_PREVIEW_TOKEN=
# Fotos von der Vereinsseite bei ClubDesk. CLUBDESK_URL ist die Wurzel der
# Vereinsseite; CLUBDESK_TEAMS ordnet je Team-ID die Teamseite unter
# /spielbetrieb/teams-und-tabellen/ zu. Geholt wird einmal am Tag: das
# Gruppenbild (Jugend nur mit freigegebenem Mannschaftsbild)
# und die Porträts (Jugend nur mit freigegebenen Spielerbildern). Leer: nichts.
# CLUBDESK_URL=https://woelfevoreifel.clubdesk.com
# CLUBDESK_TEAMS=75796=woelfe_1,96254=woelfe_b
# Welche Fotos je Mannschaft öffentlich stehen: mannschaft (Gruppenbild),
# spieler (Porträts mit Namen, auch Jugend), beides mit +. Ohne Eintrag bleiben
# die Fotos in der Vorschau. Auf der Einstellungsseite je Mannschaftszeile.
# SITE_PHOTOS=75796=mannschaft+spieler,96254=mannschaft
# Wer die Seite betreibt und wohin Rückmeldungen gehen — steht im Footer.
SITE_OPERATOR=
SITE_FEEDBACK_MAIL=
# Web-Push: das VAPID-Schlüsselpaar wird beim ersten Bedarf erzeugt und in
# der Datenbank abgelegt. Gesetzte Werte gewinnen (bei einem Umzug aus
# Todoteck übernimmt `npm run import:todoteck` das Paar, damit bestehende
# Browser-Anmeldungen gültig bleiben).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.de

# --- Übernahme aus Todoteck (einmalig) ---------------------------------------
# Pfad (im Container) zu einer Todoteck-Datenbank — am besten ein Backup-
# Snapshot. Beim Start werden Telegram-Abonnenten, Browser-Anmeldungen,
# Merker, Verlauf und das VAPID-Schlüsselpaar übernommen, genau einmal; danach
# steht im Log „übersprungen", und die Variable kann wieder raus.
# IMPORT_TODOTECK_DB=/import/familytodo.db

# --- Einstellungsseite /settings ---------------------------------------------
# Das eine Konto der Seite. Ohne ADMIN_PASSWORD (mindestens 12 Zeichen) gibt es
# die Seite nicht: jede Adresse darunter antwortet 404. Erzeugen z. B. mit:
# openssl rand -base64 24
ADMIN_USER=admin
ADMIN_PASSWORD=
# Ein eigener Anschluss nur für /settings (nur im internen Netz erreichbar
# machen, nicht über den Reverse Proxy der Microsite). Gesetzt, antwortet der
# öffentliche Anschluss auf /settings nicht mehr.
# ADMIN_PORT=3001

# --- API für das Todoteck-Cockpit --------------------------------------------
# Todoteck liest Übersicht, Details und Bilder über /api/* mit diesem Token
# (Header `Authorization: Bearer …`). Leer heißt: /api/* antwortet 401.
# Erzeugen z. B. mit: openssl rand -hex 32
API_TOKEN=
