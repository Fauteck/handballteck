# Vorlage für /opt/handballteck/.env auf dem VPS. Hier steht nur, was vor der
# Datenbank gebraucht wird; alles andere (Mannschaften, Bot-Token, Farben,
# Microsite, Einbetten …) wird auf der Einstellungsseite eingestellt und liegt
# in der Datenbank. PORT, DATA_DIR, ADMIN_PORT, TRUST_PROXY, PUBLIC_URL und
# VAPID_SUBJECT setzt docker-compose.yml selbst — nicht hier eintragen.
# Werte ohne „$" wählen (Compose würde sie als Variable lesen).

# --- Image -------------------------------------------------------------------
# Leer = latest. Für den Probelauf eines Feature-Branches: dev. Für den
# Rückweg ein SHA-Tag (README.md, „Betrieb“).
IMAGE_TAG=

# --- Caddy und Adresse ---------------------------------------------------------
# Daraus bildet docker-compose.yml auch PUBLIC_URL (https://<SITE_DOMAIN>).
SITE_DOMAIN=app.woelfe-voreifel.de
# Kontakt für Let's Encrypt (Ablaufwarnungen).
ACME_EMAIL=

# --- Einstellungsseite (nur per SSH-Tunnel, http://localhost:3411/) ----------
ADMIN_USER=admin
# openssl rand -base64 24
ADMIN_PASSWORD=

# --- Nur beim Umzug ------------------------------------------------------------
# Das VAPID-Paar liegt in der Datenbank. Hier nur eintragen, wenn es im
# bisherigen Stack als Variable gesetzt war — dann denselben Wert.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
#
# Stehen hier noch alte Werte (TEAM_IDS, TELEGRAM_BOT_TOKEN, SITE_* …): auf der
# Einstellungsseite unter „Zustand“ → „Auf diese Seite übernehmen“, danach
# hier löschen.
