# Vorlage für /opt/handballteck/.env auf dem VPS. Was jede Variable bewirkt,
# steht in der .env.example im Wurzelordner des Repos; hier nur, was der
# Betrieb auf dem VPS braucht. PORT, DATA_DIR und TRUST_PROXY
# setzt docker-compose.yml selbst — nicht hier eintragen.
# Werte ohne „$" wählen (Compose würde sie als Variable lesen).

# --- Image -------------------------------------------------------------------
# Leer = latest. Nur für den Rückweg auf einen SHA-Tag setzen (README.md, „Betrieb“).
IMAGE_TAG=

# --- Caddy -------------------------------------------------------------------
SITE_DOMAIN=app.woelfe-voreifel.de
# Kontakt für Let's Encrypt (Ablaufwarnungen).
ACME_EMAIL=

# --- Erreichbarkeit ----------------------------------------------------------
PUBLIC_URL=https://app.woelfe-voreifel.de
# Leer lassen, solange die Seiten unter PUBLIC_URL selbst liegen. Achtung: Ist
# SITE_URL auf der Einstellungsseite gespeichert, gilt der Wert von dort.
SITE_URL=

# --- Geheimnisse (beim Umzug aus dem bisherigen Stack übernehmen) ------------
TELEGRAM_BOT_TOKEN=
API_TOKEN=
# Das VAPID-Paar liegt nach dem Umzug in der Datenbank. Hier nur eintragen,
# wenn es im bisherigen Stack als Variable gesetzt war — dann denselben Wert.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://app.woelfe-voreifel.de

# --- Einstellungsseite (https://app.woelfe-voreifel.de/settings) -------------
ADMIN_USER=admin
# openssl rand -base64 24
ADMIN_PASSWORD=

# --- Startwerte, die Einstellungsseite geht vor ------------------------------
# Beim Umzug alle übrigen Variablen 1:1 aus dem bisherigen Stack übernehmen
# (TEAM_IDS, TELEGRAM_*, SYNC_*, SITE_*, CLUBDESK_*, Farben, LOG_LEVEL).
# Was auf der Einstellungsseite gespeichert ist, kommt mit der Datenbank mit.
TEAM_IDS=
# Solange auf der ClubDesk-Testseite eingebettet wird, deren Herkunft dazu:
# https://woelfevoreifel.clubdesk.com
SITE_FRAME_ANCESTORS=https://woelfe-voreifel.de,https://www.woelfe-voreifel.de
