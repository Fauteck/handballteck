{
  "name": "handballteck",
  "version": "1.0.0",
  "private": true,
  "description": "Handball-Verfolgung für eine Amateur-Mannschaft von handball.net: Microsite, Telegram-Bot, Web-Push, Kalender-Abo, Feed — und eine kleine API für das Todoteck-Cockpit.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/build.js",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run --no-file-parallelism",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "test:coverage": "vitest run --no-file-parallelism --coverage",
    "import:todoteck": "tsx scripts/import-todoteck.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "qrcode-generator": "^2.0.4",
    "sharp": "^0.35.5",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
