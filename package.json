{
  "name": "handballteck",
  "version": "1.0.0",
  "private": true,
  "description": "Handball-Verfolgung für eine Amateur-Mannschaft von handball.net: Microsite, Telegram-Bot, Web-Push, Kalender-Abo, Feed — und eine kleine API für das Todoteck-Cockpit.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/build.js",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run --no-file-parallelism",
    "test:coverage": "vitest run --no-file-parallelism --coverage",
    "import:todoteck": "tsx scripts/import-todoteck.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "better-sqlite3": "^12.6.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "sharp": "^0.35.4",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.14.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^1.6.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.15.7",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
